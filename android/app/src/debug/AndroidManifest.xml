<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug source set.

  This used to add the WRITE_ health permissions and a seed activity so fabricated
  records could be injected for emulator QA. Two reasons it is gone:

  1. A debug APK that asks to write health data looks alarming to anyone
     sideloading a beta, and the README ships that APK.
  2. Fabricated records with real timestamps made the app's own workout history
     report sessions that never happened.

  The app is read-only in every build variant now.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android" />
